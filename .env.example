# Resend (https://resend.com) API key used by app/api/contact/route.ts
# to send the contact form without leaving the page.
RESEND_API_KEY=

# Optional: where contact messages get sent. Defaults to lib/site.ts's site.email.
CONTACT_TO_EMAIL=

# Optional: the "from" address Resend sends as. Must be on a domain you
# verified in Resend. Defaults to their shared sandbox address, which only
# works for testing.
CONTACT_FROM_EMAIL=
