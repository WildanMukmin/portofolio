# Resend (https://resend.com) API key used by app/api/contact/route.ts
# to send the contact form without leaving the page.
RESEND_API_KEY=

# Optional: where contact messages get sent. Defaults to lib/site.ts's site.email.
CONTACT_TO_EMAIL=

# Optional: the "from" address Resend sends as, e.g.
# "Wildan Mukmin Portfolio <contact@wildanmukmin.my.id>". Must be on a domain
# verified in Resend. Defaults to contact@wildanmukmin.my.id.
CONTACT_FROM_EMAIL=
